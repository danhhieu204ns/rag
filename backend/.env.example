# ==============================
# BACKEND API SERVICE
# ==============================
APP_NAME = RAG App Backend
APP_ENV = development
CORS_ALLOW_ORIGINS = http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_ORIGIN_REGEX =

# ==============================
# SECURITY / AUTH
# ==============================
SECRET_KEY = change-this-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES = 1440
ADMIN_DEFAULT_USERNAME = admin
ADMIN_DEFAULT_PASSWORD = Admin@123

# ==============================
# OLLAMA SHIELD CLIENT
# ==============================
OLLAMA_BASE_URL = http://localhost:8200
OLLAMA_API_KEY = change-this-key
OLLAMA_CHAT_MODEL = default
OLLAMA_EMBEDDING_MODEL = default

# ==============================
# INGESTION SERVICE CLIENT
# ==============================
INGESTION_SERVICE_URL = http://localhost:8100
INGESTION_TIMEOUT_SECONDS = 3600

# ==============================
# RETRIEVAL SERVICE CLIENT
# ==============================
RETRIEVAL_SERVICE_URL = http://localhost:8300
RETRIEVAL_TIMEOUT_SECONDS = 180

# Simple LLM orchestrator: decide retrieval needed vs direct answer (greeting/chit-chat).
ORCHESTRATOR_ENABLED = true
ORCHESTRATOR_TIMEOUT_SECONDS = 30.0
