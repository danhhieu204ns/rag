# ==============================
# RETRIEVAL SERVICE
# ==============================
RETRIEVAL_APP_NAME = RAG Retrieval Service
RETRIEVAL_STORAGE_DIR = retrieval_service/storage

# Transitional read path for parent chunks while Document Service still lives in backend.
RETRIEVAL_DATABASE_PATH = backend/storage/app.db

# Ollama Service only, never raw Ollama.
OLLAMA_SERVICE_URL = http://localhost:8200
OLLAMA_API_KEY = change-this-key

# Vector database.
QDRANT_URL =
QDRANT_API_KEY =
QDRANT_PATH = backend/storage/indexes/global_qdrant
QDRANT_COLLECTION_NAME = global_child_chunks
VECTOR_BATCH_SIZE = 64
EMBEDDING_BATCH_SIZE = 128

RETRIEVAL_SEARCH_CHILD_CHUNKS = true
RETRIEVAL_EXPAND_TO_PARENT = true
RETRIEVAL_DEDUPLICATE_PARENTS = true
RETRIEVAL_TOP_K = 10
RETRIEVAL_TOP_K_CHILDREN = 20
RETRIEVAL_TIMEOUT_SECONDS = 180

HYBRID_PROBE_MULTIPLIER = 4
HYBRID_RRF_K = 60
HYBRID_VECTOR_RRF_WEIGHT = 1.0
HYBRID_KEYWORD_RRF_WEIGHT = 1.0

RERANKER_ENABLED = true
RERANKER_MODEL = BAAI/bge-reranker-v2-m3
RERANKER_CANDIDATE_POOL = 20

QUERY_REWRITE_ENABLED = false
QUERY_REWRITE_MIN_TERMS = 5
QUERY_REWRITE_MAX_TERMS = 12

# Keyword/BM25 retrieval. BM25 uses SQLite FTS5 over parent document_chunks
# plus selected metadata fields, then hybrid search fuses it with vector results.
BM25_ENABLED = true
BM25_BILINGUAL_EXPANSION = true
BM25_CANDIDATE_LIMIT_MULTIPLIER = 10
BM25_EXTRA_SYNONYMS =
