# ==============================
# APP / ENVIRONMENT
# ==============================
APP_NAME = RAG App Backend
APP_ENV = development

# ==============================
# SECURITY / AUTH
# ==============================
SECRET_KEY = change-this-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES = 1440
ADMIN_DEFAULT_USERNAME = admin
ADMIN_DEFAULT_PASSWORD = Admin@123

# ==============================
# OLLAMA CONNECTION (CLIENT)
# ==============================
OLLAMA_BASE_URL = 
OLLAMA_API_KEY = 

# ==============================
# VECTOR DATABASE (QDRANT)
# ==============================
QDRANT_URL = 
QDRANT_API_KEY = 
QDRANT_COLLECTION_NAME = global_child_chunks
VECTOR_BATCH_SIZE = 64

# ==============================
# DOCUMENT PARSING / CHUNKING
# ==============================
PDF_PARSER_MODE = marker
CHUNK_SIZE = 1000
CHUNK_OVERLAP = 150

# ==============================
# RETRIEVAL CORE
# ==============================
QUERY_REWRITE_ENABLED = false
QUERY_REWRITE_MIN_WORDS = 5

# ==============================
# MULTI-QUERY RETRIEVAL
# ==============================
MULTI_QUERY_ENABLED = true
MULTI_QUERY_VARIANTS = 3
MULTI_QUERY_MAX_WORKERS = 3

# ==============================
# RERANKER
# ==============================
RERANKER_ENABLED = true
RERANKER_MODEL = "BAAI/bge-reranker-v2-m3"
RERANKER_CANDIDATE_POOL = 20

# ==============================
# FRONTEND
# ==============================
VITE_API_BASE_URL = http://localhost:8000/api
# ==============================
# OLLAMA CONNECTION (REMOTE SHIELD)
# ==============================
OLLAMA_BASE_URL=https://your-shield-api.com
OLLAMA_API_KEY=your-x-api-key

# ==============================
# APP / SECURITY
# ==============================
APP_NAME=RAG App Backend
SECRET_KEY=generate-a-secure-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=Admin@123

# ==============================
# VECTOR DATABASE (QDRANT)
# ==============================
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=global_child_chunks

# ==============================
# DOCUMENT PARSING / CHUNKING
# ==============================
PDF_PARSER_MODE=legacy
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# ==============================
# RETRIEVAL / RE-RANKING
# ==============================
QUERY_REWRITE_ENABLED=false
RERANKER_ENABLED=true
RERANKER_MODEL="BAAI/bge-reranker-v2-m3"
RERANKER_CANDIDATE_POOL=20
