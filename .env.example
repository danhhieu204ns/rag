# ==============================
# RAG PLATFORM - SHARED CONFIG
# ==============================
APP_ENV=development

# Public entrypoints
API_GATEWAY_PORT=8000
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8000/api

# Security
SECRET_KEY=change-this-secret-key-in-production
SHIELD_API_KEY=change-this-key
OLLAMA_API_KEY=change-this-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=Admin@123

# Internal service URLs for Docker Compose
OLLAMA_BASE_URL=http://ollama-service:8020
OLLAMA_SERVICE_URL=http://ollama-service:8020
INGESTION_SERVICE_URL=http://ingestion-service:8100
RETRIEVAL_SERVICE_URL=http://retrieval-service:8300
QDRANT_URL=http://qdrant:6333

# Ollama upstream and models
UPSTREAM_OLLAMA_BASE_URL=http://ollama:11434
CHAT_MODEL=qwen3:30b-a3b-instruct-2507-q4_K_M
INDEXING_MODEL=qwen3:4b-instruct-2507-q4_K_M
EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_CHAT_MODEL=default
OLLAMA_EMBEDDING_MODEL=default

# Qdrant
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=global_child_chunks
VECTOR_BATCH_SIZE=64
RETRIEVAL_TOP_K=5

# Ingestion and indexing
PDF_PARSER_MODE=marker
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
METADATA_LLM_BATCH_SIZE=12
INDEXING_CONCURRENCY=12
EMBEDDING_BATCH_SIZE=128
INGESTION_TIMEOUT_SECONDS=300
RETRIEVAL_TIMEOUT_SECONDS=180

# Query and reranking
QUERY_REWRITE_ENABLED=false
QUERY_REWRITE_MIN_TERMS=5
QUERY_REWRITE_MAX_TERMS=12
HYBRID_PROBE_MULTIPLIER=4
HYBRID_RRF_K=60
HYBRID_VECTOR_RRF_WEIGHT=1.0
HYBRID_KEYWORD_RRF_WEIGHT=1.0
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_CANDIDATE_POOL=20

# Future Postgres/Redis profile. Current code still uses SQLite and BackgroundTasks.
POSTGRES_DB=rag
POSTGRES_USER=rag
POSTGRES_PASSWORD=change-this-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
REDIS_HOST=redis
REDIS_PORT=6379
