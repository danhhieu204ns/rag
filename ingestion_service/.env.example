# ==============================
# INGESTION SERVICE
# ==============================
INGESTION_APP_NAME = RAG Ingestion Service
INGESTION_STORAGE_DIR = ingestion_service/storage

# legacy: PyPDFLoader/TextLoader
# marker: Marker PDF parser
PDF_PARSER_MODE = marker

# Retrieval service used by ingestion for embedding + vector indexing
RETRIEVAL_SERVICE_URL = http://localhost:8300
RETRIEVAL_TIMEOUT_SECONDS = 180

# Shared API key (forwarded as x-api-key when calling retrieval/ollama service)
OLLAMA_BASE_URL = http://localhost:8200
OLLAMA_API_KEY = change-this-key
